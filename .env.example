# Copia este archivo como .env y completa los valores. .env nunca se versiona (CA-01.4).

# Simulador: cadena de conexión del dispositivo sim-01 (IoT Hub > Dispositivos > sim-01).
IOTHUB_DEVICE_CONNECTION_STRING=

# Preflight: cadena de conexión del dispositivo preflight-01 (marca EsPrueba = Sí).
IOTHUB_PREFLIGHT_CONNECTION_STRING=

# Scripts de demo (sin secretos): nombres y rutas del entorno.
DSA_RESOURCE_GROUP=
DSA_SITE_URL=
DSA_LIST_NAME=Eventos de seguridad
DSA_TEAM_NAME=DSA-Demo
DSA_CHANNEL_NAME=Centro de operaciones
DSA_ENVIRONMENT_KIND=default
DSA_SESSION_DATE=2026-11-04

# Flujo DisparoAgente: URL del disparador HTTP (Copilot Studio > flujo > disparador). No es un secreto
# (el disparador exige un token de Entra), pero identifica el tenant: nunca se versiona.
DSA_FLOW_URL=
# Opcionales para demo/measure.ps1: si se definen, no hace falta buscar el equipo y el canal por nombre.
DSA_TEAM_ID=
DSA_CHANNEL_ID=

# Preflight (demo/preflight.ps1): datos que no se pueden leer con una API documentada.
# URL de la organización de Dataverse del entorno (para comprobar la auditoría).
DSA_DATAVERSE_URL=
# Cómo se pagan los créditos: paygo, capacidad o prueba. Con prueba, DSA_TRIAL_END es la fecha de vencimiento.
DSA_CREDITS_MODE=prueba
DSA_TRIAL_END=
# Consumo del mes del agente (centro de administración de Power Platform) y su límite.
DSA_CREDITS_USED=
DSA_CREDITS_LIMIT=3000
# Nueva infraestructura de Power Platform: si o no.
DSA_NEW_INFRA=
