{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Propuesta del Agente de Operaciones: {{tipoEvento}} en {{zona}} · {{nombreZona}}, {{horaLocal}} COT. Ref. {{eventId}}",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Propuesta del Agente de Operaciones",
          "size": "Medium",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "{{tipoEvento}} · {{zona}} · {{nombreZona}}",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Tipo de evento", "value": "{{tipoEvento}}" },
        { "title": "Zona", "value": "{{zona}} · {{nombreZona}}" },
        { "title": "Sitio", "value": "{{sitio}}" },
        { "title": "Hora local", "value": "{{horaLocal}} COT" },
        { "title": "Severidad inicial", "value": "{{severidadInicial}}" },
        { "title": "Severidad propuesta", "value": "{{severidadPropuesta}}" },
        { "title": "Repeticiones", "value": "{{repeticiones}}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Justificación: {{justificacionSeveridad}}",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Resumen del agente",
      "weight": "Bolder",
      "spacing": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "{{resumen}}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 3
    },
    {
      "type": "TextBlock",
      "text": "Protocolo sugerido: {{protocoloAplicado}}",
      "weight": "Bolder",
      "spacing": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "{{pasosProtocolo}}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 3
    },
    {
      "type": "TextBlock",
      "text": "La decisión es tuya. \"Escalar a autoridades\" solo se registra en el incidente: ningún componente contacta a nadie.",
      "isSubtle": true,
      "spacing": "Medium",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "observacion",
      "label": "Observación (opcional)",
      "placeholder": "Escribe una nota para el registro",
      "isMultiline": true,
      "maxLength": 500
    },
    {
      "type": "TextBlock",
      "text": "Ref. {{eventId}}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Atender",
      "data": { "decision": "Atender", "eventId": "{{eventId}}" }
    },
    {
      "type": "Action.Submit",
      "title": "Escalar a autoridades",
      "data": { "decision": "Escalar a autoridades", "eventId": "{{eventId}}" }
    },
    {
      "type": "Action.Submit",
      "title": "Falsa alarma",
      "data": { "decision": "Falsa alarma", "eventId": "{{eventId}}" }
    }
  ]
}
